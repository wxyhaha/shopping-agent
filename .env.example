# Copy to the ignored root .env and set private values locally.
SHOPPING_AGENT_LLM_BASE_URL=
SHOPPING_AGENT_LLM_API_KEY=
SHOPPING_AGENT_LLM_MODEL=
SHOPPING_AGENT_LLM_TIMEOUT_SECONDS=60
SHOPPING_AGENT_BROWSER_TIMEOUT_SECONDS=55
SHOPPING_AGENT_BROWSER_MAX_SCROLLS=6
# Enable only when trusted local TUN DNS uses 198.18.0.0/15 Fake-IP; collector then uses IPv4 only.
SHOPPING_AGENT_BROWSER_TRUST_FAKE_IP_DNS=false
