{
  "name": "shopping-agent-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typegen": "openapi-typescript ../contracts/openapi.json --output src/api/schema.d.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && wxt prepare && tsc --noEmit -p tsconfig.extension.json",
    "build:web": "vite build",
    "build:chrome": "wxt build --browser chrome",
    "build:edge": "wxt build --browser edge"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "antd": "^6.6.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@wxt-dev/module-react": "^1.2.2",
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "wxt": "^0.21.5"
  }
}
